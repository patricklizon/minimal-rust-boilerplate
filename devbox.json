{
	"$schema": "https://raw.githubusercontent.com/jetify-com/devbox/0.18.4/.schema/devbox.schema.json",
	"packages": ["rustup@latest"],
	"shell": {
		"init_hook": ["rustup default stable"],
		"scripts": {
			"build": "cargo build",
			"test": "cargo test",
			"lint": "cargo clippy --all-targets --all-features -- -D warnings",
			"fmt": "cargo fmt --check"
		}
	}
}
